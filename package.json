{
  "name": "claude-companion",
  "productName": "Claude Companion",
  "version": "1.5.1",
  "description": "Claude Companion",
  "main": "app/main.js",
  "author": "Claude Companion contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/build-watcher.js",
    "start": "electron .",
    "build:watcher": "node scripts/build-watcher.js",
    "dist": "node scripts/build-watcher.js && electron-builder --win nsis --publish never",
    "release": "node scripts/release.js",
    "local": "node scripts/install-local.js",
    "test": "node --test \"tests/*.test.js\"",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "lottie-web": "5.12.2"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.claudecompanion.app",
    "productName": "Claude Companion",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "hook/hook.js",
        "to": "hook/hook.js"
      },
      {
        "from": "mcp/companion-mcp.js",
        "to": "mcp/companion-mcp.js"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "app/assets/icon.ico",
      "extraResources": [
        {
          "from": "bin/clawd.exe",
          "to": "bin/clawd.exe"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "Claude-Companion-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Para pegar en Claude lo que platicaste con un Clawd (\"Mandar a su sesión\")."
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Companion",
      "include": "build/installer.nsh",
      "artifactName": "Claude-Companion-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alejandrogvaldivia",
        "repo": "claude-companion"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alejandrogvaldivia/claude-companion.git"
  },
  "homepage": "https://github.com/alejandrogvaldivia/claude-companion"
}
